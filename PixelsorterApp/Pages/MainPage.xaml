<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelsorterApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PixelsorterApp"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:validation="clr-namespace:InputKit.Shared.Validations;assembly=InputKit.Maui"
    xmlns:viewModels="clr-namespace:PixelsorterApp.ViewModels"
    xmlns:views="clr-namespace:PixelsorterApp.Views"
    x:DataType="viewModels:MainPageViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight},
                                      Dark={StaticResource PageBackgroundDark}}"
    SemanticProperties.Description="Pixel Sorter main screen. Load an image, choose options, then sort and save."
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Padding="20,20,20,30" Spacing="16">

                <!--  Headder  -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="SpaceGroteskBold"
                        FontSize="28"
                        SemanticProperties.HeadingLevel="Level1"
                        Text="Pixel Sorter" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        FontFamily="SpaceGroteskRegular"
                        FontSize="14"
                        Opacity="0.8"
                        Text="Load an image, choose options, and sort." />
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnOpenHelpClicked"
                        Command="{Binding OpenHelpCommand}"
                        CornerRadius="18"
                        FontFamily="MaterialSymbolsFont"
                        FontSize="22"
                        HeightRequest="36"
                        SemanticProperties.Description="Open additional app options"
                        SemanticProperties.Hint="Opens help options including licenses and privacy policy"
                        Text="{x:Static local:MaterialSymbolsFont.VertMenuDots}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                    Dark={StaticResource TextSecondaryDark}}"
                        WidthRequest="36" />
                </Grid>

                <!--  Image box  -->
                <Border
                    x:Name="imagePreviewBorder"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                      Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                             Dark={StaticResource DividerDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    StyleClass="Elevation3">
                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource White}}"
                            Opacity="0.08"
                            Radius="12"
                            Offset="0,3" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto">
                        <local:ImageViewer
                            x:Name="imageViewer"
                            Grid.Row="0"
                            HeightRequest="190"
                            ImageTapped="LoadImage_Clicked"
                            IsEnabled="{Binding IsInteractionEnabled}"
                            SemanticProperties.Description="Image viewer"
                            StyleClass="Elevation5" />
                        <Grid
                            x:Name="loadingOverlay"
                            Grid.Row="0"
                            BackgroundColor="#80000000"
                            InputTransparent="False"
                            IsVisible="False"
                            SemanticProperties.Description="Busy">
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="10"
                                VerticalOptions="Center">
                                <ActivityIndicator
                                    x:Name="loadingIndicator"
                                    HeightRequest="40"
                                    IsRunning="False"
                                    WidthRequest="40"
                                    Color="{StaticResource White}" />
                                <Label
                                    x:Name="loadingOverlayLabel"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text=""
                                    TextColor="{StaticResource White}" />
                            </VerticalStackLayout>
                        </Grid>
                        <!--  Share FAB overlaid on image  -->
                        <Border
                            x:Name="shareFab"
                            Grid.Row="0"
                            Margin="0,0,8,8"
                            IsVisible="False"
                            Opacity="0"
                            Scale="0.5"
                            Style="{StaticResource ShareFabStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareImageCommand}" />
                            </Border.GestureRecognizers>
                            <Image
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="20">
                                <Image.Source>
                                    <OnPlatform x:TypeArguments="ImageSource">
                                        <On Platform="Android" Value="shareicon_android.png" />
                                        <On Platform="iOS, MacCatalyst" Value="shareicon_ios.png" />
                                        <On Platform="WinUI" Value="shareicon_windows.png" />
                                    </OnPlatform>
                                </Image.Source>
                            </Image>
                        </Border>
                        <Label
                            x:Name="whatIsThisLabel"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            FontSize="12"
                            HorizontalOptions="Center"
                            SemanticProperties.Description="Current image caption"
                            Text="{Binding CurrentCaption}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                        Dark={StaticResource TextSecondaryDark}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label
                    Margin="4,10,4,4"
                    FontAttributes="Bold"
                    FontFamily="SpaceGroteskRegular"
                    FontSize="13"
                    SemanticProperties.HeadingLevel="Level2"
                    Text="SORT SETTINGS"
                    TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource PrimaryDark}}" />

                <Border
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                      Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                             Dark={StaticResource DividerDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    StyleClass="Elevation3">
                    <Border.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource White}}"
                            Opacity="0.10"
                            Radius="10"
                            Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">
                        <VerticalStackLayout Padding="16,16,16,8" Spacing="16">
                            <material:SelectField
                                x:Name="sortBy"
                                Title="Sort by"
                                AccentColor="{AppThemeBinding Light={StaticResource Primary},
                                                              Dark={StaticResource PrimaryDark}}"
                                AllowClear="False"
                                FontFamily="DMSansRegular"
                                IsEnabled="{Binding IsInteractionEnabled}"
                                ItemsSource="{Binding SortByOptions}"
                                SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"
                                SemanticProperties.Description="A dropdown menu to select what to sort the Pixels by"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                            Dark={StaticResource TextPrimaryDark}}" />
                            <material:SelectField
                                x:Name="sortDirection"
                                Title="Direction"
                                AccentColor="{AppThemeBinding Light={StaticResource Primary},
                                                              Dark={StaticResource PrimaryDark}}"
                                AllowClear="False"
                                FontFamily="DMSansRegular"
                                IsEnabled="{Binding IsInteractionEnabled}"
                                ItemsSource="{Binding SortDirectionOptions}"
                                SelectedItem="{Binding SelectedSortDirection, Mode=TwoWay}"
                                SemanticProperties.Description="A dropdown to select in what direction to sort the pixels"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                            Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Margin="4,10,4,4"
                    FontAttributes="Bold"
                    FontFamily="SpaceGroteskRegular"
                    FontSize="13"
                    SemanticProperties.HeadingLevel="Level2"
                    Text="MASKING OPTIONS"
                    TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource PrimaryDark}}" />

                <views:MaskingOptionsView />

                <views:PresetsView />

            </VerticalStackLayout>
        </ScrollView>

        <!--  Sticky bottom action bar: Sort always visible, Save appears after first sort  -->
        <Grid
            Grid.Row="1"
            Padding="20,0,20,0"
            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight},
                                              Dark={StaticResource PageBackgroundDark}}"
            ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Hairline separator so the sticky bar reads as elevated over scroll content  -->
            <BoxView
                Grid.Row="0"
                Grid.ColumnSpan="2"
                HeightRequest="1"
                Color="{AppThemeBinding Light={StaticResource DividerLight},
                                        Dark={StaticResource DividerDark}}" />
            <Button
                x:Name="sortBtn"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,8,0,16"
                Command="{Binding SortCommand}"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsSortEnabled}"
                SemanticProperties.Description="Sort the loaded image using the current settings"
                Text="Sort" />
            <Button
                x:Name="saveBtn"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,16"
                Command="{Binding SaveCommand}"
                HorizontalOptions="Fill"
                IsEnabled="{Binding IsSaveEnabled}"
                IsVisible="{Binding IsSaveVisible}"
                MinimumWidthRequest="140"
                SemanticProperties.Description="Save the sorted image to your photo gallery"
                Style="{StaticResource SaveButtonStyle}"
                Text="Save" />
        </Grid>
    </Grid>

</ContentPage>
