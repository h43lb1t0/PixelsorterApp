<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelsorterApp.LicensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:licensemodels="clr-namespace:PixelsorterApp.Models.Licenses"
    xmlns:local="clr-namespace:PixelsorterApp"
    xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
    SemanticProperties.Description="Open source licenses used by the app">
    <Shell.TitleView>
        <Label Style="{StaticResource TitleViewLabelStyle}" Text="{localization:Translate PageName_OpenSourceLicenses}" />
    </Shell.TitleView>

    <!--  Single virtualized CollectionView (no outer ScrollView, otherwise virtualization is lost)  -->
    <CollectionView
        x:Name="LicensesCollection"
        IsGrouped="True"
        SelectionMode="None">
        <CollectionView.Header>
            <Label
                Padding="30,30,30,20"
                Opacity="0.8"
                Text="{localization:Translate LicensesPage_Explenation}" />
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="licensemodels:LicenseGroup">
                <Label
                    Margin="30,16,30,8"
                    FontAttributes="Bold"
                    FontSize="20"
                    IsVisible="{Binding HasTitle}"
                    SemanticProperties.HeadingLevel="Level2"
                    Text="{Binding Title}" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="licensemodels:LicenseInfo">
                <VerticalStackLayout Padding="46,16,46,0" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        SemanticProperties.HeadingLevel="Level3"
                        Text="{Binding PackageName}" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="{Binding Authors}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding Authors}"
                                TargetType="Label"
                                Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="13"
                        Opacity="0.6"
                        Text="{Binding PackageVersion}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding PackageVersion}"
                                TargetType="Label"
                                Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="{Binding LicenseType}" />
                    <Button
                        Command="{x:Static local:LicensesPage.OpenUrlCommand}"
                        CommandParameter="{Binding LicenseUrl}"
                        SemanticProperties.Description="{Binding LicenseUrl, StringFormat='Open license URL: {0}'}"
                        SemanticProperties.Hint="Press Enter to open this license in the browser"
                        Style="{StaticResource LinkButtonStyle}"
                        Text="{Binding LicenseUrl}" />
                    <BoxView
                        Margin="0,8,0,0"
                        AutomationProperties.IsInAccessibleTree="False"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerLight},
                                                Dark={StaticResource DividerDark}}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="30" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
