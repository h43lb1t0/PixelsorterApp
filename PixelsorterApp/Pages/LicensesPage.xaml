<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelsorterApp.LicensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PixelsorterApp"
    Title="Open Source Licenses"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight},
                                      Dark={StaticResource PageBackgroundDark}}"
    SemanticProperties.Description="Open source licenses used by the app">


    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <Label Opacity="0.8" Text="This application uses the following open source packages:" />

            <Border
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                  Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                         Dark={StaticResource DividerDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <VerticalStackLayout x:Name="LicensesContainer" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:LicenseInfo">
                            <VerticalStackLayout Padding="16" Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Text="{Binding PackageName}" />
                                <Label
                                    FontSize="13"
                                    Opacity="0.8"
                                    Text="{Binding Authors}" />
                                <Label
                                    FontSize="13"
                                    Opacity="0.6"
                                    Text="{Binding PackageVersion}" />
                                <Label
                                    FontSize="13"
                                    Opacity="0.8"
                                    Text="{Binding LicenseType}" />
                                <Button
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:LicensesPage}}, Path=OpenUrlCommand}"
                                    CommandParameter="{Binding LicenseUrl}"
                                    SemanticProperties.Description="{Binding LicenseUrl, StringFormat='Open license URL: {0}'}"
                                    SemanticProperties.Hint="Press Enter to open this license in the browser"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Text="{Binding LicenseUrl}" />
                                <BoxView
                                    Margin="0,8,0,0"
                                    AutomationProperties.IsInAccessibleTree="False"
                                    HeightRequest="1"
                                    Color="{AppThemeBinding Light={StaticResource DividerLight},
                                                            Dark={StaticResource DividerDark}}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
            <Label
                Margin="0,16,0,8"
                FontAttributes="Bold"
                FontSize="20"
                SemanticProperties.HeadingLevel="Level2"
                Text="Additional Licenses" />
            <Border
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                  Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                         Dark={StaticResource DividerDark}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <VerticalStackLayout Padding="16" Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        SemanticProperties.HeadingLevel="Level3"
                        Text="RMBG-1.4" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="Bria.ai" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="CC-BY-NC" />
                    <Button
                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:LicensesPage}}, Path=OpenUrlCommand}"
                        CommandParameter="https://creativecommons.org/licenses/by-nc/4.0/"
                        SemanticProperties.Description="Open license URL: https://creativecommons.org/licenses/by-nc/4.0/"
                        SemanticProperties.Hint="Press Enter to open this license in the browser"
                        Style="{StaticResource LinkButtonStyle}"
                        Text="https://creativecommons.org/licenses/by-nc/4.0/" />
                    <BoxView
                        Margin="0,8,0,0"
                        AutomationProperties.IsInAccessibleTree="False"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerLight},
                                                Dark={StaticResource DividerDark}}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        SemanticProperties.HeadingLevel="Level3"
                        Text="Example Images" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="Tom Haelbich" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="© Tom Haelbich" />
                    <Button
                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:LicensesPage}}, Path=OpenUrlCommand}"
                        CommandParameter="https://github.com/h43lb1t0/PixelsorterApp/blob/main/LICENSE-EXAMPLE-IMAGES.txt"
                        SemanticProperties.Description="Open license URL: https://github.com/h43lb1t0/PixelsorterApp/blob/main/LICENSE-EXAMPLE-IMAGES.txt"
                        SemanticProperties.Hint="Press Enter to open this license in the browser"
                        Style="{StaticResource LinkButtonStyle}"
                        Text="https://github.com/h43lb1t0/PixelsorterApp/blob/main/LICENSE-EXAMPLE-IMAGES.txt" />
                    <BoxView
                        Margin="0,8,0,0"
                        AutomationProperties.IsInAccessibleTree="False"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerLight},
                                                Dark={StaticResource DividerDark}}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        SemanticProperties.HeadingLevel="Level3"
                        Text="Material Symbols &amp; Icons" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="By Google" />
                    <Label
                        FontSize="13"
                        Opacity="0.8"
                        Text="Apache-2.0" />
                    <Button
                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:LicensesPage}}, Path=OpenUrlCommand}"
                        CommandParameter="https://github.com/google/material-design-icons/blob/master/LICENSE"
                        SemanticProperties.Description="Open license URL: https://github.com/google/material-design-icons/blob/master/LICENSE"
                        SemanticProperties.Hint="Press Enter to open this license in the browser"
                        Style="{StaticResource LinkButtonStyle}"
                        Text="https://github.com/google/material-design-icons/blob/master/LICENSE" />
                    <BoxView
                        Margin="0,8,0,0"
                        AutomationProperties.IsInAccessibleTree="False"
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource DividerLight},
                                                Dark={StaticResource DividerDark}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
