<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelsorterApp.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:indiko="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown">
    <Shell.TitleView>
        <Label
            FontAttributes="Bold"
            FontFamily="SpaceGroteskBold"
            FontSize="22"
            Text="How to use the Pixelsorter"
            TextColor="{StaticResource Primary}"
            VerticalOptions="Center" />
    </Shell.TitleView>
    <Grid
        Padding="15"
        RowDefinitions="Auto,*"
        RowSpacing="14">
        <ScrollView Grid.Row="1">
            <indiko:MarkdownView
                x:Name="MarkdownDisplay"
                TextFontSize="15"
                UseAppTheme="True" />
        </ScrollView>
    </Grid>
</ContentPage>