<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PixelsorterApp.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:indiko="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
    xmlns:properties="clr-namespace:PixelsorterApp.Resources.Languages">
    <Shell.TitleView>
        <Label
            FontSize="22"
            Style="{StaticResource TitleViewLabelStyle}"
            Text="{x:Static properties:NavigationStrings.HelpPage_DisplayPageName_HowToUseThePixelsorter}" />
    </Shell.TitleView>
    <Grid
        Padding="15"
        RowDefinitions="Auto,*"
        RowSpacing="14">
        <ScrollView Grid.Row="1">
            <indiko:MarkdownView
                x:Name="MarkdownDisplay"
                TextFontSize="15"
                UseAppTheme="True" />
        </ScrollView>
    </Grid>
</ContentPage>