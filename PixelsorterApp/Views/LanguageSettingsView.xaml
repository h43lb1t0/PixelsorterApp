<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PixelsorterApp.Views.LanguageSettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PixelsorterApp"
    xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:viewModels="clr-namespace:PixelsorterApp.ViewModels"
    x:DataType="viewModels:SettingsViewModel">
    <VerticalStackLayout Spacing="16">
        <Label
            SemanticProperties.HeadingLevel="Level2"
            Style="{StaticResource CardHeaderLabel}"
            Text="{localization:Translate LanguageSettingsView_LanguageSettings}"
            TextTransform="Uppercase" />

        <Border StyleClass="Elevation3">
            <Border.Shadow>
                <Shadow
                    Brush="{AppThemeBinding Light={StaticResource Black},
                                            Dark={StaticResource White}}"
                    Opacity="0.10"
                    Radius="10"
                    Offset="0,3" />
            </Border.Shadow>

            <VerticalStackLayout Padding="16" Spacing="16">
                <!--  1. Choose language dropdown (Workaround for UraniumUI bug #715)  -->
                <VerticalStackLayout Spacing="6">
                    <Label
                        FontSize="12"
                        Text="{localization:Translate LanguageSettingsView_ChooseLanguage}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                    Dark={StaticResource TextPrimaryDark}}" />
                    <material:SelectField
                        AllowClear="False"
                        Icon="{FontImageSource FontFamily=MaterialSymbolsFont,
                                               Glyph={x:Static local:MaterialSymbolsFont.Language}}"
                        ItemDisplayBinding="{Binding NativeName}"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        Style="{StaticResource MySelectFieldStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                    Dark={StaticResource TextPrimaryDark}}" />
                </VerticalStackLayout>

                <!--  2. Native name sort note  -->
                <Label
                    FontSize="13"
                    Text="{localization:Translate LanguagesAreSortedByTheirNativeNames}"
                    TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                Dark={StaticResource TextSecondaryDark}}" />

                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />

                <!--  3. Weblate status & translation guarantee in the same box  -->
                <Border
                    Padding="16"
                    BackgroundColor="Transparent"
                    Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                             Dark={StaticResource DividerDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="75"
                            HorizontalOptions="Center"
                            Source="localization_progress.png" />
                        <Label
                            FontSize="12"
                            Text="{localization:Translate LanguageSettingsView_TranslationGuarantee}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                        Dark={StaticResource TextSecondaryDark}}" />
                        <Button
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="https://hosted.weblate.org/engage/pixelsorter/"
                            HorizontalOptions="Center"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Text="{localization:Translate LanguageSettingsView_HelpUsLocalizingTheApp}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentView>
