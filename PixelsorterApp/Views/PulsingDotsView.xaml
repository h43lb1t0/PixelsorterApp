<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PixelsorterApp.Views.PulsingDotsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <HorizontalStackLayout
        x:Name="DotsContainer"
        HorizontalOptions="Center"
        Spacing="12">

        <!--  Each Ellipse starts dim; code-behind drives opacity, TranslationY, and Scale  -->
        <Ellipse
            x:Name="Dot1"
            Fill="{StaticResource Primary}"
            HeightRequest="10"
            Opacity="0.3"
            WidthRequest="10" />

        <Ellipse
            x:Name="Dot2"
            Fill="{StaticResource Primary}"
            HeightRequest="10"
            Opacity="0.3"
            WidthRequest="10" />

        <Ellipse
            x:Name="Dot3"
            Fill="{StaticResource Primary}"
            HeightRequest="10"
            Opacity="0.3"
            WidthRequest="10" />

    </HorizontalStackLayout>

</ContentView>