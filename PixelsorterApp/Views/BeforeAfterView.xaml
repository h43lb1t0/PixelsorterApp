<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PixelsorterApp.Views.BeforeAfterView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight},
                                          Dark={StaticResource SurfaceDark}}"
        Stroke="{AppThemeBinding Light={StaticResource DividerLight},
                                 Dark={StaticResource DividerDark}}"
        StrokeShape="RoundRectangle 28"
        StrokeThickness="1"
        StyleClass="Elevation3">
        <Border.Shadow>
            <Shadow
                Brush="{AppThemeBinding Light={StaticResource Black},
                                        Dark={StaticResource White}}"
                Opacity="0.12"
                Radius="18"
                Offset="0,6" />
        </Border.Shadow>

        <Grid
            x:Name="CompareGrid"
            HeightRequest="300"
            SizeChanged="CompareGrid_SizeChanged"
            WidthRequest="400">

            <!--  Bottom layer: "after" image, always fully visible  -->
            <Image
                x:Name="AfterImage"
                Aspect="AspectFit"
                Source="{Binding AfterImageSource, Source={x:Reference Root}}" />

            <!--  Top layer: "before" image, clipped to reveal only part of it  -->
            <Image
                x:Name="BeforeImage"
                Aspect="AspectFit"
                Source="{Binding BeforeImageSource, Source={x:Reference Root}}" />

            <!--  Divider line that follows the reveal edge  -->
            <BoxView
                x:Name="DividerLine"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                WidthRequest="2"
                Color="White" />

            <!--  Slider control to drag the reveal point  -->
            <Slider
                x:Name="CompareSlider"
                Margin="10"
                Maximum="1"
                Minimum="0"
                ValueChanged="OnSliderValueChanged"
                VerticalOptions="End"
                Value="0.5" />
        </Grid>
    </Border>
</ContentView>
