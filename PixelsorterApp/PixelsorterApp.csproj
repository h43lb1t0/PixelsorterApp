<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<NeutralLanguage>en-GB</NeutralLanguage>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PixelsorterApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>PixelsorterApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.pixelsorterapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">34.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#D32F2F" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFB066" BaseSize="684,684" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\**" Exclude="Resources\Images\**\*.json" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="Resources\Images\**\*.json" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Indiko.Maui.Controls.Markdown" Version="1.10.0" />
		<PackageReference Include="LocalizationResourceManager.Maui" Version="1.2.6" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
		<PackageReference Include="Tomlyn" Version="2.10.1" />
		<PackageReference Include="UraniumUI" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
		<PackageReference Include="UXDivers.Popups.Maui" Version="0.9.4" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\PixelsorterClassLib\PixelsorterClassLib\PixelsorterClassLib.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Pages\ExampleGallery.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\HelpPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\LicensesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\PresetsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\PrivacyPolicyPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Pages\SettingsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Popups\ConfirmationPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Popups\NavigationPopup.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\BeforeAfterView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\CannyMaskOptionsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\LanguageSettingsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\LuminanceMaskView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\MaskCombinationView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\MaskingOptionsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\WhatToSortView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\PresetsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MaskViews\SubjectMaskOptionsView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<Target Name="GenerateCombinedLicenses" BeforeTargets="PrepareForBuild">
		<Exec Command="dotnet tool restore --tool-manifest &quot;$(MSBuildProjectDirectory)\..\.config\dotnet-tools.json&quot;" />
		<Exec Command="dotnet tool run nuget-license -i &quot;$(MSBuildProjectFullPath)&quot; -o Json -fo &quot;$(ProjectDir)Resources/Raw/licenses.$(MSBuildProjectName).json&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\.." IgnoreExitCode="true" />
		<Exec Condition="'@(ProjectReference)' != ''" Command="dotnet tool run nuget-license -i &quot;%(ProjectReference.FullPath)&quot; -o Json -fo &quot;$(ProjectDir)Resources/Raw/licenses.%(ProjectReference.Filename).json&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\.." IgnoreExitCode="true" />
	</Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidEnableR8>true</AndroidEnableR8>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidCreateProguardMappingFile>true</AndroidCreateProguardMappingFile>
  </PropertyGroup>



	<ItemGroup>
		<MauiAsset Include="Resources\Raw\licenses.json" LogicalName="licenses.json" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Pages\PresetsPage.xaml.cs">
	    <DependentUpon>PresetsPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\Languages\AppStrings.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>AppStrings.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\Languages\PrivacyPolicyStrings.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>PrivacyPolicyStrings.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\Languages\AppStrings.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>AppStrings.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Languages\PrivacyPolicyStrings.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>PrivacyPolicyStrings.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

	<!-- Auto-generate LocalizationConfig.g.cs from .resx files so Weblate-added languages are picked up automatically -->
	<UsingTask TaskName="GenerateSupportedCulturesTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<ResxFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<DefaultCultures ParameterType="System.String" Required="false" />
			<OutputFile ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Using Namespace="System.Linq" />
			<Using Namespace="System.Globalization" />
			<Using Namespace="System.Collections.Generic" />
			<Code Type="Fragment" Language="cs">
<![CDATA[
				// Collect culture codes from DefaultCultures param and .resx filenames
				var cultures = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);

				foreach (var c in (DefaultCultures ?? "").Split(';').Where(s => s.Length > 0))
					cultures.Add(c);

				foreach (var item in ResxFiles)
				{
					var name = Path.GetFileNameWithoutExtension(item.ItemSpec);
					var dot = name.LastIndexOf('.');
					if (dot < 0) continue;
					var tag = name.Substring(dot + 1);
					try { CultureInfo.GetCultureInfo(tag); cultures.Add(tag); }
					catch { /* not a culture code, skip */ }
				}

				// Generate the partial class
				var entries = string.Join(", ", cultures.Select(c => $"\"{c}\""));
				var code =
@"// <auto-generated/>
using System.Collections.Generic;
using System.Globalization;
using System.Linq;

namespace PixelsorterApp;

public static partial class LocalizationConfig
{
    public static readonly IReadOnlyList<CultureInfo> SupportedCultures =
        new[] { " + entries + @" }
            .Select(CultureInfo.GetCultureInfo)
            .OrderBy(c => c.NativeName)
            .ToList();
}
";
				var outDir = Path.GetDirectoryName(OutputFile);
				if (!string.IsNullOrEmpty(outDir) && !Directory.Exists(outDir))
					Directory.CreateDirectory(outDir);

				if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != code)
					File.WriteAllText(OutputFile, code, System.Text.Encoding.UTF8);
]]>
			</Code>
		</Task>
	</UsingTask>

	<Target Name="GenerateSupportedLocalizationCultures" BeforeTargets="CoreCompile;XamlPreCompile">
		<ItemGroup>
			<_ResxLocalizationFiles Include="Resources\Languages\*.resx" />
		</ItemGroup>
		<PropertyGroup>
			<_GeneratedLocalizationConfigFile>$(IntermediateOutputPath)LocalizationConfig.g.cs</_GeneratedLocalizationConfigFile>
		</PropertyGroup>
		<GenerateSupportedCulturesTask ResxFiles="@(_ResxLocalizationFiles)" DefaultCultures="en-GB;en-US" OutputFile="$(_GeneratedLocalizationConfigFile)" />
		<ItemGroup>
			<Compile Include="$(_GeneratedLocalizationConfigFile)" />
			<FileWrites Include="$(_GeneratedLocalizationConfigFile)" />
		</ItemGroup>
	</Target>

</Project>
